# Supabase — set these to enable real Auth + DB. When absent, backend runs in mock mode
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server
PORT=3001
HOST=0.0.0.0
# CORS — comma-separated origins, e.g. http://localhost:5173,http://localhost:5175
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:5174
# When true, OTP 123456 is accepted for demo@mytracker.local even without Supabase
DEMO_AUTH_FALLBACK=true
