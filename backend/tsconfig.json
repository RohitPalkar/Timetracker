{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/server.ts", "src/config/**/*", "src/lib/**/*", "src/plugins/**/*", "src/modules/**/*", "src/db/client.ts", "src/db/mock.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/db/migrate.ts", "src/db/seed.ts"]
}
